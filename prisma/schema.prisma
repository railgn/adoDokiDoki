generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["referentialIntegrity"]
}

datasource db {
  provider             = "mysql"
  url                  = env("DATABASE_URL")
  referentialIntegrity = "prisma"
}

model adoURLs {
  id         Int      @id @default(autoincrement())
  url        String   @unique
}

model adoArticlesJP {
  id         Int      @id @default(autoincrement())
  url        String   @unique
  data       Json
}

model adoArticlesEN {
  id         Int      @id @default(autoincrement())
  url        String   @unique
  data       Json
}